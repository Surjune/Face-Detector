# Copy to .env and fill in. Every value is optional depending on which command you run.
#
#   verify / tamper-demo / run --replay  ->  needs nothing at all
#   run --chain local                    ->  needs SERPAPI_KEY only
#   run (live, on Sepolia)               ->  needs SERPAPI_KEY + PRIVATE_KEY + REGISTRY_ADDRESS

# Free tier: 250 searches/month, no card. https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Keyless public endpoint; override only if you prefer your own node.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Sepolia-only throwaway key, funded from https://sepolia-faucet.pk910.de
# NEVER put a key here that holds real funds.
PRIVATE_KEY=

# Deployed PostRegistry address. Ships pre-filled in artifacts/deployment.json,
# so set this only if you deploy your own copy.
REGISTRY_ADDRESS=

# Public base URL used to hand the probe image to Google Lens, which needs a URL
# rather than an upload. Defaults to this repo's raw content host.
GITHUB_RAW_BASE=https://raw.githubusercontent.com/Surjune/Face-Detector/main

# ---------------------------------------------------------------------------
# Optional: deeper social media search. Every service below has a free tier
# that needs no payment card. The pipeline runs without any of them.
# ---------------------------------------------------------------------------

# Searches YouTube natively rather than relying on what Lens happened to index.
# Free: 10,000 quota units a day, one search costs 100. No billing account.
# Enable "YouTube Data API v3" at https://console.cloud.google.com and make a key.
YOUTUBE_API_KEY=

# Reads the subject's name out of search titles when Lens has not already
# supplied it, so targeted per-platform queries can be built. Set EITHER one.
# Both are free with no card, and only one short call is made per run.
#   Groq   https://console.groq.com
#   Gemini https://aistudio.google.com/apikey  (same Google account as above)
GROQ_API_KEY=
GEMINI_API_KEY=

# Pin a specific model. Defaults are rolling aliases so they do not expire:
# gemini-flash-lite-latest on Gemini, openai/gpt-oss-20b on Groq.
LLM_MODEL=
